# ─────────────────────────────────────────────
# Database (PostgreSQL, matches docker-compose.yml)
# ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://db:5432/carwatch
DB_USERNAME=carwatch
DB_PASSWORD=carwatch
DB_DRIVER=org.postgresql.Driver

# ─────────────────────────────────────────────
# SMTP (required for drift emails)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ─────────────────────────────────────────────
# Polling behaviour (optional overrides)
# ─────────────────────────────────────────────
CARWATCH_POLL_INTERVAL=PT10M
CARWATCH_POLL_INITIAL_DELAY=PT10S
CARWATCH_POLL_REQUEST_DELAY_MS=1500
CARWATCH_POLL_USER_AGENT=Mozilla/5.0 (compatible; CarWatchdog/0.1)

# ─────────────────────────────────────────────
# Scraper selectors (optional overrides)
# ─────────────────────────────────────────────
CARWATCH_SCRAPER_DONEDEAL_BASE_URL=https://www.donedeal.ie
CARWATCH_SCRAPER_USERCARSNI_BASE_URL=https://www.usercarsni.com
